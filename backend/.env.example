# ---------------------------------------------------------------------------
# TriVerify backend configuration. Copy to backend/.env and edit.
# Never commit .env.
# Every value below has a working default — the demo runs with no .env at all.
# ---------------------------------------------------------------------------
# Database. Omit entirely for a local SQLite file (zero setup, works offline).
# Supabase: Project Settings -> Database -> Connection string -> URI.
# Prefer the connection POOLER (port 6543) for serverless/containers; the app
# detects it and disables prepared statements automatically.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Browser origins allowed to call the API. Use the Vercel URL in production.
# TRIVERIFY_CORS_ORIGINS=https://triverify.vercel.app

# Engine thresholds. Below CONFIDENCE_THRESHOLD a field becomes REVIEW;
# below FAIL_CONFIDENCE_THRESHOLD a mismatch is recorded as REVIEW, not FAIL.
# TRIVERIFY_CONFIDENCE_THRESHOLD=0.65
# TRIVERIFY_FAIL_CONFIDENCE_THRESHOLD=0.70

# Live external sources. OFF by default — the demo must never need the network.
# TRIVERIFY_LIVE_SOURCES=0

# Force the fixture OCR engine even when Tesseract is installed.
# TRIVERIFY_FORCE_FIXTURE_OCR=0

# Stamped onto every case so a result is traceable to the rules that made it.
# TRIVERIFY_RULESET_VERSION=triverify-rules-v1
